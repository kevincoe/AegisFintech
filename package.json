{
  "name": "aegis-fintech-study-case",
  "version": "1.0.0",
  "private": true,
  "description": "Pragmatic Software Architecture & Engineering Study Case: Full-Stack Banking & Stock Market Platform",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@aegis/api",
    "dev:web": "turbo run dev --filter=@aegis/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
